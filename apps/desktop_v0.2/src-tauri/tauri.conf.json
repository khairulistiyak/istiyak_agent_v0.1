{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "desktop-v0.2",
  "version": "0.2.0",
  "identifier": "com.khairulistiyak.desktopv02",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Companion Chat UI v0.2",
        "width": 1050,
        "height": 700,
        "resizable": true,
        "transparent": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
